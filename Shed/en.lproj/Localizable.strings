// Rules
"rules.title" = "How to Play";
"rules.done"  = "Done";

"rules.objective.title" = "Objective";
"rules.objective.text"  = "Be the first player to get rid of all your cards — hand, table, and blind cards.";

"rules.setup.title" = "Setup";
"rules.setup.text1" = "Each player gets 3 blind cards (face-down), 3 table cards (face-up), and 3 hand cards.";
"rules.setup.text2" = "Before the game starts, you can swap any hand card with any of your table cards.";

"rules.join.title" = "Joining Table Cards";
"rules.join.text1" = "During the arrange phase, tap two cards of the same rank to join them into one slot — either two table cards together, or a hand card onto a matching table card.";
"rules.join.text2" = "Joined cards stay grouped on the table and are played together as a single move. To move a group back to your hand instead, tap the slot to select it, then tap it again — the cards will move to your hand and be played normally when your turn comes.";

"rules.turn.title" = "Taking a Turn";
"rules.turn.text1" = "Play one or more cards of the same rank onto the pile. The card(s) must be ≥ the top card of the pile.";
"rules.turn.text2" = "After playing, draw back up to 3 hand cards while the deck lasts.";
"rules.turn.text3" = "If you can't play, pick up the entire pile and it becomes part of your hand.";

"rules.zones.title" = "Card Zones";
"rules.zones.text1" = "You play from your hand first. Once your hand is empty you play from your table cards. Once those are gone you flip blind cards one at a time.";
"rules.zones.text2" = "If a blind card can't be played, you pick up the pile plus that card.";

"rules.special.title"   = "Special Cards";
"rules.special.text2"   = "Resets the pile — can be played on anything. Next player can play any card.";
"rules.special.text7"   = "Forces low mode — next player must play 7 or lower. Stacks of 7s keep low mode active.";
"rules.special.text10"  = "Burns the pile — removes all cards from play. Same player goes again.";

"rules.burn.title" = "Burning the Pile";
"rules.burn.text"  = "Playing a 10 burns the pile. You also burn the pile if you complete four-of-a-kind on top. After a burn you play again immediately.";

"rules.peek.title" = "Peeking at the Pile";
"rules.peek.text1" = "Tap the discard pile at any time to see every card in it, from top to bottom. Enable this in Settings.";
"rules.peek.text2" = "Use this to decide whether picking up the pile is worth it — it could help you or hurt you.";

"rules.dig.title" = "The Dig (once per game)";
"rules.dig.text1" = "Once per game, while playing from your hand, tap Dig to swap your entire hand with the discard pile. Enable this in Settings.";
"rules.dig.text2" = "Your old hand becomes the new pile (lowest card on top). The pile cards become your new hand. Your turn ends immediately after digging.";

"rules.win.title" = "Winning";
"rules.win.text"  = "The first player to play their last card wins. The other player is the Shizzman.";

