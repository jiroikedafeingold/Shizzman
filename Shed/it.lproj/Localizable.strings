// Rules
"rules.title" = "Come Giocare";
"rules.done"  = "Fatto";

"rules.objective.title" = "Obiettivo";
"rules.objective.text"  = "Sii il primo a liberarti di tutte le carte — mano, tavolo e coperte.";

"rules.setup.title" = "Preparazione";
"rules.setup.text1" = "Ogni giocatore riceve 3 carte coperte (faccia in giù), 3 carte da tavolo (faccia in su) e 3 carte in mano.";
"rules.setup.text2" = "Prima di iniziare, puoi scambiare qualsiasi carta della mano con una sul tavolo.";

"rules.turn.title" = "Il Tuo Turno";
"rules.turn.text1" = "Gioca una o più carte dello stesso valore sul mazzo. Le carte devono essere ≥ alla carta in cima.";
"rules.turn.text2" = "Dopo aver giocato, pesca fino a 3 carte finché il mazzo ha carte.";
"rules.turn.text3" = "Se non puoi giocare, prendi tutto il mazzo nella tua mano.";

"rules.zones.title" = "Zone Carte";
"rules.zones.text1" = "Prima giochi dalla mano. Poi le carte da tavolo, poi giri le carte coperte una alla volta.";
"rules.zones.text2" = "Se una carta coperta non può essere giocata, prendi il mazzo più quella carta.";

"rules.special.title"   = "Carte Speciali";
"rules.special.text2"   = "Azzera il mazzo — giocabile su qualsiasi carta. Il prossimo giocatore può giocare qualsiasi carta.";
"rules.special.text7"   = "Forza modalità bassa — il prossimo giocatore deve giocare 7 o meno. Più 7 mantengono la modalità attiva.";
"rules.special.text10"  = "Brucia il mazzo — rimuove tutte le carte. Lo stesso giocatore gioca di nuovo.";

"rules.burn.title" = "Bruciare il Mazzo";
"rules.burn.text"  = "Giocare un 10 brucia il mazzo. Completare quattro carte uguali in cima lo brucia anche. Dopo aver bruciato, giochi subito.";

"rules.peek.title" = "Vedere il Mazzo";
"rules.peek.text1" = "Tocca il mazzo degli scarti in qualsiasi momento per vedere tutte le carte dall'alto verso il basso. (Attiva nelle Impostazioni)";
"rules.peek.text2" = "Usalo per decidere se vale la pena prendere il mazzo.";

"rules.win.title" = "Vittoria";
"rules.win.text"  = "Il primo giocatore a giocare l'ultima carta vince. L'altro giocatore è lo Shizzman.";

"rules.dig.title" = "Lo Scavo (una volta per partita)";
"rules.dig.text1" = "Una volta per partita, mentre giochi dalla mano, tocca Scava per scambiare tutta la tua mano con il mazzo degli scarti. (Attiva nelle Impostazioni)";
"rules.dig.text2" = "La tua vecchia mano diventa il nuovo mazzo (carta più bassa sopra). Le carte del mazzo diventano la tua nuova mano. Il tuo turno termina immediatamente dopo lo scavo.";

